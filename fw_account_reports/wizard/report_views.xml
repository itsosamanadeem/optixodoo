<odoo>
    <record id="report_form" model="ir.ui.view">
        <field name="name">fw.account.report.wizard.form</field><field name="model">fw.account.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Accounting Report">
                <header>
                    <button name="action_preview" type="object" string="View Report" class="oe_highlight"/>
                    <button name="action_print" type="object" string="Print PDF" icon="fa-print"/>
                    <button name="action_export" type="object" string="Export CSV" icon="fa-download"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="report_type" readonly="1" force_save="1"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="date_from" invisible="report_type == 'aging'"/>
                            <field name="date_to"/>
                            <field name="target_moves" invisible="report_type != 'transactions'"/>
                            <field name="include_zero" invisible="report_type != 'suppliers'"/>
                        </group>
                        <group invisible="report_type == 'income'">
                            <field name="partner_ids" widget="many2many_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="account_ids" widget="many2many_tags" invisible="report_type not in ('aging', 'suppliers', 'transactions')" domain="[('company_ids', 'in', [company_id])]" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Analytic Dimensions" invisible="report_type != 'income'">
                        <group>
                            <field name="cost_plan_id" required="report_type == 'income'" options="{'no_create': True}"/>
                            <field name="city_plan_id" options="{'no_create': True}"/>
                            <field name="cost_center_ids" widget="many2many_tags" domain="[('plan_id', 'child_of', cost_plan_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="city_ids" widget="many2many_tags" invisible="not city_plan_id" domain="[('plan_id', 'child_of', city_plan_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        </group>
                        <group><field name="code_from"/><field name="code_to"/></group>
                    </group>
                    <group string="Tax Account Mapping" invisible="report_type not in ('payments', 'payment_taxes', 'annexure')">
                        <div class="text-muted" colspan="2">Choose deduction accounts here, or set Accounting Report Tax Category on the chart of accounts. Existing income-tax account mappings are also recognized.</div>
                        <field name="wht_account_ids" widget="many2many_tags" domain="[('company_ids', 'in', [company_id])]" options="{'no_create': True}"/>
                        <field name="stsp_account_ids" widget="many2many_tags" domain="[('company_ids', 'in', [company_id])]" options="{'no_create': True}"/>
                    </group>
                    <div style="overflow-x:auto;"><field name="preview" nolabel="1" invisible="not preview"/></div>
                    <field name="export_file" invisible="1"/><field name="export_filename" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aging" model="ir.actions.act_window"><field name="name">Age Analysis ACP</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'aging'}</field></record>
    <record id="action_income" model="ir.actions.act_window"><field name="name">Cost Centre-wise Income</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'income'}</field></record>
    <record id="action_payments" model="ir.actions.act_window"><field name="name">List of Payments (All)</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'payments'}</field></record>
    <record id="action_payment_taxes" model="ir.actions.act_window"><field name="name">List of Payments (Taxes)</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'payment_taxes'}</field></record>
    <record id="action_annexure" model="ir.actions.act_window"><field name="name">Sales Tax Annexure Report</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'annexure'}</field></record>
    <record id="action_suppliers" model="ir.actions.act_window"><field name="name">Supplier Balances</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'suppliers'}</field></record>
    <record id="action_transactions" model="ir.actions.act_window"><field name="name">Transaction List</field><field name="res_model">fw.account.report.wizard</field><field name="view_mode">form</field><field name="context">{'default_report_type': 'transactions'}</field></record>
    <menuitem id="menu_aging" name="Age Analysis ACP" parent="account.menu_finance_reports" action="action_aging" sequence="70" groups="account.group_account_readonly"/>
    <menuitem id="menu_income" name="Cost Centre-wise Income" parent="account.menu_finance_reports" action="action_income" sequence="71" groups="account.group_account_readonly"/>
    <menuitem id="menu_payments" name="List of Payments (All)" parent="account.menu_finance_reports" action="action_payments" sequence="72" groups="account.group_account_readonly"/>
    <menuitem id="menu_payment_taxes" name="List of Payments (Taxes)" parent="account.menu_finance_reports" action="action_payment_taxes" sequence="73" groups="account.group_account_readonly"/>
    <menuitem id="menu_annexure" name="Sales Tax Annexure Report" parent="account.menu_finance_reports" action="action_annexure" sequence="74" groups="account.group_account_readonly"/>
    <menuitem id="menu_suppliers" name="Supplier Balances" parent="account.menu_finance_reports" action="action_suppliers" sequence="75" groups="account.group_account_readonly"/>
    <menuitem id="menu_transactions" name="Transaction List" parent="account.menu_finance_reports" action="action_transactions" sequence="76" groups="account.group_account_readonly"/>
</odoo>
