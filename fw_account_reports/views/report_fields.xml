<odoo>
    <record id="account_report_category_form" model="ir.ui.view">
        <field name="name">account.account.optix.report.category</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after"><field name="fw_tax_category"/></field>
        </field>
    </record>
    <record id="partner_report_fields" model="ir.ui.view">
        <field name="name">res.partner.optix.report.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="fw_cnic" groups="account.group_account_readonly"/>
                <field name="fw_supplier_type" groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>
    <record id="move_report_fields" model="ir.ui.view">
        <field name="name">account.move.optix.report.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AP Report Details" invisible="move_type not in ('in_invoice', 'in_refund')" groups="account.group_account_readonly">
                    <group>
                        <group><field name="fw_challan_received"/><field name="fw_hs_code"/><field name="fw_purchase_type"/></group>
                        <group><field name="fw_prt_type"/><field name="fw_deduction_doc_type"/><field name="fw_deduction_date"/></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="payment_report_fields" model="ir.ui.view">
        <field name="name">account.payment.optix.report.fields</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Payment Tax Report Details" invisible="payment_type != 'outbound'" groups="account.group_account_readonly">
                    <field name="company_currency_id" invisible="1"/>
                    <field name="fw_payment_nature"/><field name="fw_taxable_base_set"/>
                    <field name="fw_taxable_base" invisible="not fw_taxable_base_set"/>
                    <field name="fw_wht_rate"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
