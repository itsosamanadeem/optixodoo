<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_pr_budget" model="ir.ui.view">
        <field name="name">project.project.form.pr.budget</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="inside">
                <button name="action_submit_for_approval"
                        string="Submit for Approval"
                        type="object"
                        class="btn-primary"
                        invisible="approval_state != 'draft'"/>
                <button name="action_approve_project"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        invisible="not can_approve_project"/>
                <button name="action_reject_project"
                        string="Reject"
                        type="object"
                        invisible="approval_state != 'under_approval'"/>
                <button name="action_reset_project_to_draft"
                        string="Reset to Draft"
                        type="object"
                        groups="project.group_project_manager"
                        invisible="approval_state == 'draft'"/>
                <field name="approval_state"
                       widget="statusbar"
                       statusbar_visible="draft,under_approval,approved,rejected"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_project_purchase_requisitions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o">
                    <field name="approval_request_count"
                           widget="statinfo"
                           string="Purchase Requisitions"/>
                </button>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Project Financial Summary">
                    <group>
                        <field name="approval_group_id" readonly="approval_state == 'approved'"/>
                        <field name="current_approval_level_id" readonly="1"/>
                        <field name="can_approve_project" invisible="1"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="project_total_cost" readonly="1"/>
                        <field name="utilized_amount" readonly="1"/>
                        <field name="remaining_amount" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Project Products" name="project_products">
                    <field name="project_product_line_ids"
                           readonly="approval_state == 'approved'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="unit_cost"/>
                            <field name="total_cost" readonly="1"/>
                            <field name="requested_qty" readonly="1"/>
                            <field name="remaining_qty" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Approvals" name="project_approvals">
                    <field name="project_approval_line_ids" readonly="1">
                        <list>
                            <field name="sequence"/>
                            <field name="approval_level_id"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="status" widget="badge"
                                   decoration-info="status == 'waiting'"
                                   decoration-warning="status == 'pending'"
                                   decoration-success="status == 'approved'"
                                   decoration-danger="status == 'rejected'"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                            <field name="comments"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_kanban_pr_budget" model="ir.ui.view">
        <field name="name">project.project.kanban.pr.budget</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="approval_state"/>
                <field name="project_total_cost"/>
                <field name="utilized_amount"/>
                <field name="remaining_amount"/>
                <field name="currency_id"/>
            </xpath>
            <xpath expr="//templates//t[@t-name='card']" position="inside">
                <div class="mt-2">
                    <span t-attf-class="badge #{record.approval_state.raw_value == 'approved' ? 'text-bg-success' : record.approval_state.raw_value == 'under_approval' ? 'text-bg-warning' : record.approval_state.raw_value == 'rejected' ? 'text-bg-danger' : 'text-bg-secondary'}">
                        <field name="approval_state"/>
                    </span>
                </div>
                <div class="mt-1 small text-muted">
                    <span>Total: <field name="project_total_cost"/></span>
                    <span class="ms-2">Used: <field name="utilized_amount"/></span>
                    <span class="ms-2">Left: <field name="remaining_amount"/></span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
