<odoo>
    <record id="view_cost_center_expense_form" model="ir.ui.view">
        <field name="name">cost.center.expense.wizard.form</field>
        <field name="model">cost.center.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Cost Centre-wise Expenses">
                <header>
                    <button name="action_preview" type="object" string="View Report" class="oe_highlight"/>
                    <button name="action_print" type="object" string="Print PDF" icon="fa-print"/>
                    <button name="action_export_excel" type="object" string="Export Excel" icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="site_name"/>
                        </group>
                        <group>
                            <field name="cost_plan_id" options="{'no_create': True}"/>
                            <field name="city_plan_id" options="{'no_create': True}"/>
                            <field name="cost_center_ids" widget="many2many_tags" domain="[('plan_id', 'child_of', cost_plan_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="city_ids" widget="many2many_tags" invisible="not city_plan_id" domain="[('plan_id', 'child_of', city_plan_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="code_from"/>
                            <field name="code_to"/>
                        </group>
                    </group>
                    <field name="preview" nolabel="1" invisible="not preview"/>
                    <field name="excel_file" invisible="1"/>
                    <field name="excel_filename" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cost_center_expense" model="ir.actions.act_window">
        <field name="name">Cost Centre-wise Expenses</field>
        <field name="res_model">cost.center.expense.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_cost_center_expense" name="Cost Centre-wise Expenses"
              parent="account.menu_finance_reports" action="action_cost_center_expense"
              sequence="25" groups="account.group_account_readonly"/>
</odoo>
