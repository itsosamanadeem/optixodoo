<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_line_filter_wizard_purchase_form" model="ir.ui.view">
        <field name="name">budget.line.filter.wizard.purchase.form</field>
        <field name="model">budget.line.filter.wizard.purchase</field>
        <field name="arch" type="xml">
            <form string="Filter Budget Lines">
                <group>
                    <field name="budget_analytic_id"/>
                </group>
                <group>
                    <group>
                        <field name="account_id"/>
                        <field name="x_plan6_id"/>
                        <field name="x_plan8_id"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="budget_amount_operator"/>
                        <field name="budget_amount"
                               invisible="not budget_amount_operator"/>
                    </group>
                </group>
                <footer>
                    <button string="Apply Filters"
                            name="action_apply_filters"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
