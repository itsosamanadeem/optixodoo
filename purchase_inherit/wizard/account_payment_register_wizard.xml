<odoo>
    <record id="view_account_payment_register_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//field[@name='amount']" position="after">
                <field name="price_unit" readonly="1"/>
            </xpath>
            <xpath expr="/form//group[@name='group2']" position="after">
                <field name="income_tax_ids">
                    <list editable="bottom">
                        <field name="tax_id"/>
                        <field name="account_id" readonly="1"/>
                        <field name="amount"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
