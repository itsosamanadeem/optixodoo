<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operation" model="ir.ui.view">
        <field name="name">stock.move.form.operation.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="/form//widget[@name='import_lots']" position="after">
                <button
                    name="action_open_serial_import_wizard"
                    type="object"
                    string="Import Serials XLSX"
                    class="btn btn-link btn-group"
                    invisible="not display_assign_serial"
                />
            </xpath>
        </field>
    </record>

    <record id="view_move_line_list_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/list//field[@name='lot_id']" position="attributes">
                <attribute name="string">Asset Tag No.</attribute>
            </xpath>
            <xpath expr="/list//field[@name='lot_name']" position="attributes">
                <attribute name="string">Asset Tag No.</attribute>
            </xpath>
            <xpath expr="/list//field[@name='lot_id']" position="before">
                <field name="serial_no" column_invisible="False"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_list_detailed_operation_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.list.detailed_operation.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/list//field[@name='product_id']" position="after">
                <field name="serial_no" column_invisible="False"/>
            </xpath>
            <xpath expr="/list//field[@name='lot_name']" position="attributes">
                <attribute name="string">Assest Tag</attribute>
            </xpath>
        </field>
    </record>
</odoo>
