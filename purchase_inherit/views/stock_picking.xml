<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_asset_tag_no" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.asset.tag.no</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form//field[@name='user_id']" position="after">
                <field name="product_default_code" readonly="1"/>
                <field name="asset_tag_no" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
