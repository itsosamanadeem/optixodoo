<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="view_account_payment_form_inherit_dxl" model="ir.ui.view">
        <field name="name">account.payment.inherit.dxl</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="oe_title">
                    <h3>
                        <field name="payment_reference" nolabel="1"/>
                    </h3>
                </div>
            </xpath>
            <xpath expr="//field[@name='date']" position="before">
                <field name="actual_amount"/>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('name', '!=', '')]</attribute>
            </field>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Bills">
                        <field name="reconcile_invoice_ids" readonly="state not in ['draft','sent']">
                            <!-- attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}" -->
                            <list editable="bottom" create="false">
                                <field name="reconcile"/>
                                <field name="invoice_id" string="Bill Number" readonly="1" force_save="1"/>
                                <field name="amount_untaxed" readonly="1" force_save="1"/>
                                <field name="amount_tax" readonly="1" force_save="1"/>
                                <field name="amount_total" readonly="1" force_save="1"/>
                                <field name="already_paid" readonly="1" force_save="1"/>
                                <field name="amount_residual" readonly="1" force_save="1"/>
                                <field name="full_wht_deduction" optional="hide"/>
                                <field name="it_wht_amount" column_invisible="parent.wht_type == 'amount' " />
                                <!-- attrs="{'column_invisible': [('parent.wht_type', '=', 'amount')]}" -->
                                <field name="st_wht_amount" column_invisible="parent.wht_type == 'amount' " />
                                <field name="it_wht_amt" column_invisible="parent.wht_type == 'percentage' " />
                                <!-- attrs="{'column_invisible': [('parent.wht_type', '=', 'percentage')]}" -->
                                <field name="st_wht_amt" column_invisible="parent.wht_type == 'percentage' " />
                                <field name="amount_paid"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <!-- 18890 / 52400 Muhammad Ashhad Jamal -->
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="gst_withholding_type" required="True" readonly="state != 'draft'" invisible = "wht_type == 'amount'"/>
                <field name="gst_tax_id" domain="[('type_tax_use', '=', 'sale' if payment_type=='inbound' else 'purchase') , ('tds', '=', True) , ('wht_type', '=', 'gst_wht_type')]" required="gst_withholding_type != 'default'" invisible="gst_withholding_type == 'default'" readonly="state != 'draft'"/> <!-- Rao Abdul Rehman (Task ID: 18890) -->
                <field name="td_amt" invisible="gst_withholding_type == 'default'" readonly="1"/>
                <field name="gst_account_id" invisible="wht_type != 'amount' or gst_withholding_type == 'default'" readonly="state not in ['draft','sent']"/>
            </xpath>
            <!-- 18890 / 52400 Muhammad Ashhad Jamal -->
        </field>
    </record>
    <record id="account_payment_register_view_form" model="ir.ui.view">
        <field name="name">account.payment.register.view.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="after">
                <group>
                    <field name="wht_type" widget="radio"/>
                    <field name="income_account_id" invisible="wht_type != 'amount'" />
                    <field name="sales_account_id" invisible="wht_type != 'amount'" />
                    <field name="sales_tds_type" invisible="wht_type != 'amount'" required="True"/>
                    <field name="sales_tds_tax_id" invisible="wht_type != 'amount' or sales_tds_type == 'default'" required="sales_tds_type != 'default'" domain="[('tds','=',True), ('wht_type', '=', 'sales_tax')]"/>
                    <!-- attrs="{'invisible':['|', ('wht_type', '=', 'amount'), ('sales_tds_type','=', 'default')],
                            'required': [('sales_tds_type','!=','default')]}" -->
                    <field name="sales_tds_amt" invisible="sales_tds_type == 'default'" required="wht_type == 'percentage'" readonly="1"/>
                    <!-- attrs="{'invisible':[('sales_tds_type','=', 'default')], 'readonly': [('wht_type', '=', 'percentage')]}" -->
                    <field name="tds_type" required="True" invisible="wht_type == 'amount'" />
                    <!-- attrs="{'invisible': [('wht_type', '=', 'amount')]}" -->
                    <field name="tds_tax_id" invisible="tds_type == 'default'" required="tds_type != 'default'" domain="[('tds','=',True), ('wht_type', '=', 'income_tax')]"/>
                    <!-- attrs="{'invisible':[('tds_type','=', 'default')],'required': [('tds_type','!=','default')]}" -->
                    <field name="tds_amt" invisible="tds_type == 'default'" readonly="1"/>
                    <!-- attrs="{'invisible':[('tds_type','=', 'default')]}" -->
                </group>
            </xpath>
            <xpath expr="//group" position="after">
                <notebook>
                    <page string="Bills">
                        <field name="reconcile_invoice_ids" create="false" widget="one2many">
                            <list editable="bottom">
                                <field name="reconcile"/>
                                <field name="invoice_id" string="Bill Number" readonly="1" force_save="1"/>
                                <field name="amount_untaxed" readonly="1" force_save="1"/>
                                <field name="amount_tax" readonly="1" force_save="1"/>
                                <field name="amount_total" readonly="1" force_save="1"/>
                                <field name="already_paid" readonly="1" force_save="1"/>
                                <field name="amount_residual" readonly="1" force_save="1"/>
                                <field name="is_editable_deduction" invisible="1"/>
                                <field name="full_wht_deduction" readonly="is_editable_deduction == True" optional="hide"/>
                                <!-- attrs="{'readonly': [('is_editable_deduction', '=', True)]}" -->
                                <field name="it_wht_amount"  column_invisible="parent.wht_type == 'amount'" />
                                <!-- attrs="{'column_invisible': [('parent.wht_type', '=', 'amount')]}" -->
                                <field name="st_wht_amount" column_invisible="parent.wht_type == 'amount'" />
                                <field name="it_wht_amt" column_invisible="parent.wht_type == 'percentage'" />
                                <field name="st_wht_amt" column_invisible="parent.wht_type == 'percentage'" />
                                <field name="amount_paid"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="base.paperformat_euro" model="report.paperformat">
        <field name="dpi">118</field>
    </record>
    <record id="account_payment_view_tree" model="ir.ui.view">
        <field name="name">account.payment.view.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="payment_reference"/>
            </field>
        </field>
    </record>
    <record id="account_payment_view_search" model="ir.ui.view">
        <field name="name">account.payment.view.search.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="payment_reference"/>
            </field>
        </field>
    </record>
</odoo>
