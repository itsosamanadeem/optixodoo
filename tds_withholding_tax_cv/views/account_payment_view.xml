<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_tis_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.tis</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="wht_type" widget="radio" options="{'horizontal': true}" readonly="state not in ['draft','sent']"  force_save="1"/>
                <!-- attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}" -->
                <field name="bill_type" widget="radio" options="{'horizontal': true}" invisible="1"/>
                <field name="income_account_id" invisible="wht_type != 'amount'" readonly="state not in ['draft','sent']" />
                <!-- attrs="{'invisible': [('wht_type', '!=', 'amount')], 'readonly': [('state', 'not in', ['draft', 'sent'])]}" -->
                <field name="sales_account_id" invisible="wht_type != 'amount'" readonly="state not in ['draft','sent']" />
                <!-- attrs="{'invisible': [('wht_type', '!=', 'amount')], 'readonly': [('state', 'not in', ['draft', 'sent'])]}" -->
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="sales_tds_type"
                     invisible="wht_type == 'amount'" readonly="state != 'draft'"
                       
                       required="True"/>
                       <!-- attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('wht_type', '=', 'amount')]}" -->
                <field name="vendor_type" invisible="1"/>
                <field name="sales_tds_tax_id"
                     invisible="wht_type == 'amount' or sales_tds_type == 'default'"
                     readonly="state != 'draft'"
                     required="sales_tds_type != 'default'"
                       
                       domain="[('tds','=',True), ('wht_type', '=', 'sales_tax')]"/>
                       <!-- attrs="{'invisible':['|', ('wht_type', '=', 'amount'), ('sales_tds_type','=', 'default')],
                            'readonly': [('state', '!=', 'draft')],
                            'required': [('sales_tds_type','!=','default')]}" -->
                <field name="sales_tds_amt"
                     invisible="wht_type == 'amount' or sales_tds_type == 'default'"
                        readonly="1"/>
                        <!-- attrs="{'invisible':['|', ('wht_type', '=', 'amount'), ('sales_tds_type','=', 'default')]}" -->
                <field name="tds_type"
                     invisible="wht_type == 'amount'"
                     readonly="state != 'draft'"
                       
                       required="True"/>
                       <!-- attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('wht_type', '=', 'amount')]}" -->
                <field name="vendor_type" invisible="1"/>
                <field name="tds_tax_id"
                     invisible="tds_type == 'default'"
                     readonly="state != 'draft'"
                     required="tds_type !='default'"
                       
                       domain="[('tds','=',True), ('wht_type', '=', 'income_tax')]"/>
                       <!-- attrs="{'invisible':[('tds_type','=', 'default')],
                            'readonly': [('state', '!=', 'draft')],
                            'required': [('tds_type','!=','default')]}" -->
                <field name="tds_amt"
                     invisible="tds_type == 'default'"
                        readonly="1"/>
                        <!-- attrs="{'invisible':[('tds_type','=', 'default')]}" -->
            </xpath>
        </field>
    </record>
</odoo>