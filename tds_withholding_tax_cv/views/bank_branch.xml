<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_branch_form" model="ir.ui.view">
        <field name="name">bank.branch.form</field>
        <field name="model">bank.branch</field>
        <field name="arch" type="xml">
            <form string="Bank Branch">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_branch_list" model="ir.ui.view">
        <field name="name">bank.branch.list</field>
        <field name="model">bank.branch</field>
        <field name="arch" type="xml">
            <list string="Bank Branches">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_bank_branch" model="ir.actions.act_window">
        <field name="name">Bank Branches</field>
        <field name="res_model">bank.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bank_branch_main" name="Manage Branches" parent="account.menu_finance_payables" action="action_bank_branch" sequence="10"/>
</odoo>
