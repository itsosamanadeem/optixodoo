<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_partner_form_tis_tds_inherit" model="ir.ui.view">
	    <field name="name">res.partner.form.tis.tds</field>
	    <field name="model">res.partner</field>
	    <field name="inherit_id" ref="base.view_partner_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//notebook/page[@name='sales_purchases']" position="after">
	    		<page name="partner_tds" string="WHT">
	    			<group>
	    				<group>
	    					<field name="tds_threshold_check" string="Sales Tax"/>
							<field name="income_wht" atring="Income Tax"/>
	    				</group>
	    				<group>
	    					<field name="wht_id" domain="[('tds', '=', True),('wht_type','=','sales_tax')]" invisible="tds_threshold_check == False" />
							<!-- attrs="{'invisible': [('tds_threshold_check', '=', False)]}" -->
							<field name="income_tax_id" domain="[('tds', '=', True),('wht_type','=','income_tax')]"  invisible="income_wht == False" />
							<!-- attrs="{'invisible': [('income_wht', '=', False)]}" -->
	    				</group>
	    			</group>
	    		</page>
	    	</xpath>
	    </field>
	</record>

	<record id="view_partner_bank_form_inherit_branch_name" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.branch</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="account.view_partner_bank_form_inherit_account"/>
        <field name="arch" type="xml">
            <xpath expr="//form[@name='bank_account_form']/sheet[1]/group[1]/group[2]/div[1]" position="after">
                <field name="branch_id"/>
            </xpath>
        </field>
    </record>
</odoo>
